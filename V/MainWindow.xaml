<mah:MetroWindow
    x:Class="show.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:show"
    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Y/ShowDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border
                    local:AnimationsHelper.AnimateOpacity="{Binding ButtonCheckShow}"
                    local:AnimationsHelper.AnimateX="{Binding BorderX}"
                    MouseEnter="Border_MouseEnter"
                    MouseLeave="Border_MouseLeave"
                    Visibility="{Binding ButtonCanCheck}">
                    <Button
                        Width="80"
                        Height="40"
                        Background="SeaGreen" />
                </Border>
            </StackPanel>
        </Grid>
        <Grid Grid.Column="1">
            <CheckBox
                Width="50"
                Height="50"
                IsChecked="{Binding CheckBoreder}"
                MouseEnter="CheckBox_MouseEnter"
                MouseLeave="CheckBox_MouseLeave"
                Style="{StaticResource CheckBoxShow}" />
            <Border
                Grid.ColumnSpan="3"
                Width="400"
                Height="100"
                Margin="-100,-110"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                local:AnimationsHelper.AnimateY="{Binding BorderY}"
                Background="AliceBlue"
                BorderBrush="#22000000"
                BorderThickness="1"
                CornerRadius="10"
                MouseEnter="Border_MouseEnter"
                MouseLeave="Border_MouseLeave">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="16"
                    Foreground="Black"
                    Text="{Binding Textshows}" />
                <Border.Effect>
                    <DropShadowEffect
                        x:Name="shadowEffect"
                        BlurRadius="20"
                        Opacity="5"
                        ShadowDepth="0"
                        Color="#11100000" />
                </Border.Effect>

            </Border>
        </Grid>
    </Grid>
</mah:MetroWindow>
