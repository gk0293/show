<mah:MetroWindow
    x:Class="show.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:show"
    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="MainWindow"
    Width="800"
    Height="450"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Y/ShowDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>

        <CheckBox
            Width="50"
            Height="50"
            Style="{StaticResource CheckBoxShow}" 
            MouseEnter="CheckBox_MouseEnter"
            MouseLeave="CheckBox_MouseLeave"
            IsChecked="{Binding CheckBoreder}"
            />
        <Border
            local:AnimationsHelper.AnimateY="{Binding BorderY}"
            Margin="0,-110"
            Width="400"
            Height="100"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="AliceBlue"
            BorderBrush="#22000000"
            BorderThickness="1"
            CornerRadius="10"
            MouseEnter="Border_MouseEnter"
            MouseLeave="Border_MouseLeave"
            >
            <TextBlock
                Text="{Binding Textshows}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                Foreground="Black" />
            <Border.Effect>
                <DropShadowEffect
                    x:Name="shadowEffect"
                    BlurRadius="20"
                    Opacity="5"
                    ShadowDepth="0"
                    Color="#11100000" />
            </Border.Effect>
           
        </Border>

    </Grid>
</mah:MetroWindow>
