<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">

    <Style x:Key="CheckBoxShow" TargetType="CheckBox">
        <Setter Property="Background" Value="White" />
        
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border
                        x:Name="but"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="White"
                        BorderBrush="Gray"
                        BorderThickness="2"
                        CornerRadius="50"
                        >
                        <!--  添加阴影效果  -->
                        <Border.Effect>
                            <DropShadowEffect
                                x:Name="shadowEffect"
                                BlurRadius="20"
                                Opacity="0"
                                ShadowDepth="0"
                                Color="#88000000" />
                        </Border.Effect>
                        <iconPacks:PackIconMaterial
                            x:Name="Cog"
                            Width="40"
                            Height="40"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Kind="CogOutline"
                            RotationAngle="0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!--  阴影动画  -->
                                        <DoubleAnimation
                                            Storyboard.TargetName="but"
                                            Storyboard.TargetProperty="(Effect).BlurRadius"
                                            To="15"
                                            Duration="0:0:0.3" />

                                        <DoubleAnimation
                                            Storyboard.TargetName="but"
                                            Storyboard.TargetProperty="(Effect).Opacity"
                                            To="0.7"
                                            Duration="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>

                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="but"
                                            Storyboard.TargetProperty="(Effect).BlurRadius"
                                            To="0"
                                            Duration="0:0:0.3" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="but"
                                            Storyboard.TargetProperty="(Effect).Opacity"
                                            To="0"
                                            Duration="0:0:0.3" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!--  背景颜色动画  -->
                                        <ColorAnimation
                                            Storyboard.TargetName="but"
                                            Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"
                                            To="Black"
                                            Duration="0:0:0.2" />
                                        <!--  图标颜色动画  -->
                                        <ColorAnimation
                                            Storyboard.TargetName="Cog"
                                            Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)"
                                            To="White"
                                            Duration="0:0:0.2" />
                                        <!--旋转-->
                                        <DoubleAnimation
                                            Storyboard.TargetName="Cog"
                                            Storyboard.TargetProperty="RotationAngle"
                                            From="0"
                                            To="90"
                                            Duration="0:0:0.35" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>

                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <!--  恢复背景颜色  -->
                                        <ColorAnimation
                                            Storyboard.TargetName="but"
                                            Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"
                                            To="White"
                                            Duration="0:0:0.2" />
                                        <!--  恢复图标颜色  -->
                                        <ColorAnimation
                                            Storyboard.TargetName="Cog"
                                            Storyboard.TargetProperty="(Foreground).(SolidColorBrush.Color)"
                                            To="Black"
                                            Duration="0:0:0.2" />
                                        <!--旋转-->
                                        <DoubleAnimation
                                            Storyboard.TargetName="Cog"
                                            Storyboard.TargetProperty="RotationAngle"
                                            To="0"
                                            Duration="0:0:0.5" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
   
</ResourceDictionary>